# Rackula environment overrides
# Copy/edit this file as .env alongside docker-compose.yml

# --- Networking ---
RACKULA_PORT=8080
RACKULA_LISTEN_PORT=8080
RACKULA_API_PORT=3001

# --- Reverse proxy (only if Rackula sits behind a trusted proxy) ---
# RACKULA_TRUST_PROXY=1

# --- CORS / API security ---
# Set to your real domain in production
CORS_ORIGIN=http://localhost:8080
# Generate with: openssl rand -hex 32
RACKULA_API_WRITE_TOKEN=c4118923374b7359052e5592e6663a89b770a9e3f08f50ac0eb9a5abd42f13a4

# --- Auth (none | oidc | local) ---
RACKULA_AUTH_MODE=none
# Required if RACKULA_AUTH_MODE is oidc or local (min 32 chars)
# Generate with: openssl rand -hex 32
RACKULA_AUTH_SESSION_SECRET=ee7fe72fb5fef48ad2548a5b98abb2ce49931c9032235f5b1dcc96d498f74d85

# Only used when RACKULA_AUTH_MODE=local
# RACKULA_LOCAL_USERNAME=fred
# RACKULA_LOCAL_PASSWORD=fred

# --- Session hardening (defaults usually fine) ---
# RACKULA_AUTH_SESSION_MAX_AGE_SECONDS=43200
# RACKULA_AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
# RACKULA_AUTH_SESSION_COOKIE_SAMESITE=Lax
# RACKULA_AUTH_SESSION_COOKIE_SECURE=true
# RACKULA_AUTH_CSRF_PROTECTION=true

# --- Only for isolated/local HTTP testing ---
# ALLOW_INSECURE_CORS=false
